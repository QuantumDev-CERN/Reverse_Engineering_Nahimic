[AzAudModel0.CNXTRender]
AddReg = ProductId_AddReg,Lenovo_VendorName

[ProductId_AddReg]
;; PKEY_AudioEndpoint_Association
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\1,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\2,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

;; PKEY_PRODUCTID
HKR,EP\0,%PKEY_PRODUCTID%,%REG_SZ%,%PRODUCTID%
HKR,EP\1,%PKEY_PRODUCTID%,%REG_SZ%,%PRODUCTID%
HKR,EP\2,%PKEY_PRODUCTID%,%REG_SZ%,%PRODUCTID%

;; PKEY_PRODUCTID_ISST
HKR,EP\0,%PKEY_PRODUCTID_ISST%,%REG_SZ%,%PRODUCTID%
HKR,EP\1,%PKEY_PRODUCTID_ISST%,%REG_SZ%,%PRODUCTID%
HKR,EP\2,%PKEY_PRODUCTID_ISST%,%REG_SZ%,%PRODUCTID%

;; PKEY_SUPPORT: value 2 for Senary
HKR,EP\0,%PKEY_SUPPORT%,%REG_DWORD%,0x2
HKR,EP\1,%PKEY_SUPPORT%,%REG_DWORD%,0x2
HKR,EP\2,%PKEY_SUPPORT%,%REG_DWORD%,0x2

[Lenovo_VendorName]
;; PKEY_VENDORNAME
HKR,EP\0,%PKEY_VENDORNAME%,%REG_SZ%,"Lenovo"
HKR,EP\1,%PKEY_VENDORNAME%,%REG_SZ%,"Lenovo"
HKR,EP\2,%PKEY_VENDORNAME%,%REG_SZ%,"Lenovo"

