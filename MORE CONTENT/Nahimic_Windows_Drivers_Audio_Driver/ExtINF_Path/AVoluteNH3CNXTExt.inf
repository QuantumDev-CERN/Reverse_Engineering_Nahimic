[Version]
Signature = "$WINDOWS NT$"
Class = Extension
ClassGuid = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider = %Provider%
ExtensionId = {741a2100-1023-11e9-b56e-0800200c9a66}
DriverVer = 07/16/2025,1.3.16.0
PnpLockdown = 1
CatalogFile = AVoluteNH3Ext.cat

[SourceDisksNames]
222 = %DiskId1%

[SourceDisksFiles]
NH3CNXTProductSettings1.cab=222

[DestinationDirs]
;; Windows\System32\A-Volute\AGSConfigurator\
AVoluteProdSettings1.CopyList = 11,\A-Volute\AGSConfigurator

[AVoluteProdSettings1.CopyList]
NH3CNXTProductSettings1.cab

[Manufacturer]
%Provider% = DeviceExtensions,NTamd64.10.0...15063

[DeviceExtensions.NTamd64.10.0...15063]
%Device.ExtensionDesc% = CNXTHDARender0_Install,INTELAUDIO\FUNC_01&VEN_14F1&DEV_1F87&SUBSYS_17AA383B

[CNXTHDARender0_Install]
CopyFiles = AVoluteProdSettings1.CopyList

[CNXTHDARender0_Install.Components]
AddComponent = AVOLUTE_NH4APO,,APONH_Install

[CNXTHDARender0_Install.Devices]
AddDevice = Nahimic_Mirroring,,Nahimic_Mirroring_RootDevice_Inst
AddDevice = Nahimic_BTLink,,Nahimic_BTLink_RootDevice_Inst
AddDevice = Nahimic_XVAD,,Nahimic_XVAD_RootDevice_Inst

[APONH_Install]
ComponentIDs = VEN_AVOL&AID_0802
Description = "Nahimic Nh4 Audio Effects Component"

[Nahimic_Mirroring_RootDevice_Inst]
HardwareIds = ROOT\Nahimic_Mirroring

[Nahimic_BTLink_RootDevice_Inst]
HardwareIds = ROOT\NahimicBTLink

[Nahimic_XVAD_RootDevice_Inst]
HardwareIds = ROOT\NahimicXVAD

[CNXTHDARender0_Install.Interfaces]
