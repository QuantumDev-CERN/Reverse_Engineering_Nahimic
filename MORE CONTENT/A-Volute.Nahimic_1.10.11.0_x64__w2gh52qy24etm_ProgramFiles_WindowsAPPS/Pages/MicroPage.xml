	</Effect>
	<Effect>
		<Name>Lateral Sound Cancellation</Name>
		<Priority>3</Priority>
		<Mode>0</Mode>
		<Visibility>1</Visibility>
	</Effect>
    <Effect>
        <Name>Voice Stabilizer</Name>
        <Priority>4</Priority>
        <Mode>1</Mode>
        <Visibility>1</Visibility>
    </Effect>
